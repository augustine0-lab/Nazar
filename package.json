{
  "name": "nazar",
  "version": "0.1.0",
  "private": true,
  "description": "Nazar, команда вокруг ребёнка: платформа поддержки школьников с СДВГ",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "db:purge": "tsx src/db/purge.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:backup": "tsx src/db/backup.ts",
    "mail:flush": "tsx src/db/mail.ts"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "^15.5.28",
    "nodemailer": "^7.0.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
